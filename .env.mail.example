# One environment file per process. Never share OAuth clients or signing/encryption keys.
MCP_PROFILE=mail
MCP_TRANSPORT=streamable-http
MCP_HOST=127.0.0.1
MCP_PORT=18003
MCP_AUTH_MODE=multi-user
YANDEX_AUTH_MODE=multi-user
MCP_ISSUER_URL=https://yandex-mail.kabagun.top
MCP_RESOURCE_SERVER_URL=https://yandex-mail.kabagun.top/mcp
MCP_OAUTH_CALLBACK_URL=https://yandex-mail.kabagun.top/oauth/yandex/callback
MCP_ALLOWED_HOSTS=["yandex-mail.kabagun.top"]
MCP_ALLOWED_ORIGINS=["https://chatgpt.com","https://yandex-mail.kabagun.top"]
MCP_TRUSTED_PROXY_CIDRS=["127.0.0.1/32","::1/128"]
MCP_CURSOR_KEYS=["REPLACE_WITH_UNIQUE_BASE64URL_32_BYTE_KEY"]
MCP_TOKEN_ENCRYPTION_KEYS=["REPLACE_WITH_DIFFERENT_BASE64URL_32_BYTE_KEY"]
AUTH_STORE_BACKEND=redis
REDIS_URL=redis://:REPLACE_WITH_REDIS_PASSWORD@127.0.0.1:18002/0
YANDEX_OAUTH_CLIENT_ID=REPLACE_WITH_MAIL_CLIENT_ID
YANDEX_OAUTH_CLIENT_SECRET=REPLACE_WITH_MAIL_CLIENT_SECRET
MAIL_READ=true
MAIL_WRITE=true
MAIL_DELETE=true
MAIL_MAX_MESSAGE_BYTES=10485760
MAIL_MAX_ATTACHMENT_BYTES=5242880
MAIL_TIMEOUT_SECONDS=30
