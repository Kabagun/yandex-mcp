MCP_PROFILE=workspace
# Dedicated hosted services: see .env.disk.example and .env.mail.example.
YANDEX_OAUTH_TOKEN=
YANDEX_WIKI_ORG_ID=
YANDEX_AUTH_MODE=oauth
YANDEX_IAM_TOKEN=
YANDEX_IAM_ORG_ID=
YANDEX_OAUTH_CLIENT_ID=
YANDEX_OAUTH_CLIENT_SECRET=

YANDEX_DISK_ENABLED=true
YANDEX_WIKI_ENABLED=true

MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=8000
MCP_AUTH_MODE=local
MCP_AUTH_TOKEN=
MCP_STATIC_SCOPES=
MCP_ISSUER_URL=http://localhost:8000
MCP_RESOURCE_SERVER_URL=http://localhost:8000
MCP_OAUTH_CALLBACK_URL=
MCP_ALLOWED_HOSTS=
MCP_ALLOWED_ORIGINS=
MCP_TRUSTED_PROXY_CIDRS=
MCP_CURSOR_KEYS=
MCP_TOKEN_ENCRYPTION_KEYS=
MCP_MAX_REQUEST_BODY_BYTES=2097152
MCP_CLIENT_REGISTRATION_CAP=100
MCP_CLIENT_SECRET_EXPIRY_SECONDS=2592000
AUTH_STORE_BACKEND=memory
REDIS_URL=

DISK_READ=true
DISK_WRITE=false
DISK_DELETE=false

WIKI_READ=true
WIKI_WRITE=false
WIKI_DELETE=false

DISK_ALLOWED_ROOTS=/Work,/Research
DISK_UPLOAD_ALLOWED_DIRS=
DISK_MAX_UPLOAD_BYTES=104857600
DISK_UPLOAD_URL_ALLOWED_HOSTS=
DISK_ALLOWED_PUBLIC_KEYS=
DISK_ALLOW_GLOBAL_DESTRUCTIVE=false
DISK_UPLOAD_JOB_CAPACITY=100
DISK_UPLOAD_JOB_TTL_SECONDS=3600
WIKI_ALLOWED_ROOTS=projects,research
WIKI_UPLOAD_ALLOWED_DIRS=
WIKI_MAX_ATTACHMENT_BYTES=104857600

YANDEX_MAIL_ENABLED=false
MAIL_READ=true
MAIL_WRITE=false
MAIL_DELETE=false
MAIL_MAX_MESSAGE_BYTES=10485760
MAIL_MAX_ATTACHMENT_BYTES=5242880
MAIL_TIMEOUT_SECONDS=30
